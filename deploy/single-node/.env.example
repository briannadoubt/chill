CHILL_IMAGE=chill:local
CHILL_VERSION=dev
CHILL_COMMIT=unknown
CHILL_BUILD_TIME=unknown

# localhost receives a Caddy-managed local certificate. For a public deployment,
# set a DNS name pointing at the host and bind the standard ports on all interfaces.
CHILL_DOMAIN=localhost
CHILL_HTTP_BIND=127.0.0.1
CHILL_HTTP_PORT=8080
CHILL_HTTPS_BIND=127.0.0.1
CHILL_HTTPS_PORT=8443

# Exact browser origin allowed to call chilld. Leave empty when the console is
# served by Caddy on CHILL_DOMAIN; set it when another origin hosts the console.
CHILL_CONSOLE_ORIGIN=

CHILL_BACKUP_DIR=./backups
CHILL_BACKUP_RETENTION_DAYS=7

POSTGRES_IMAGE=postgres:18.4-alpine3.24@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
