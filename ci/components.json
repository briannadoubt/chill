{
  "components": [
    {
      "id": "contract",
      "owners": ["platform"],
      "paths": [
        "budgets",
        "conformance",
        "contracts",
        "examples/behavior",
        "examples/otlp",
        "policies",
        "schemas"
      ],
      "release_artifact": "contracts",
      "state": "active",
      "versioning": "contract-major"
    },
    {
      "id": "backend",
      "owners": ["platform"],
      "paths": ["backend", "deploy/single-node"],
      "release_artifact": "oci-image",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "swift",
      "owners": ["apple"],
      "paths": ["sdk/swift", "validation/apple"],
      "release_artifact": "swift-source-archive",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "console",
      "owners": ["product", "platform"],
      "paths": ["console"],
      "release_artifact": "console-image",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "android",
      "owners": ["android"],
      "paths": ["sdk/android"],
      "release_artifact": "android-package",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "web",
      "owners": ["web"],
      "paths": ["sdk/web"],
      "release_artifact": "npm-package",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "portable-rust",
      "owners": ["platform"],
      "paths": ["sdk/rust"],
      "release_artifact": "rust-source-archive",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "javascript-runtime",
      "owners": ["platform"],
      "paths": ["sdk/js/packages/runtime"],
      "release_artifact": "javascript-source-archive",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "electron",
      "owners": ["desktop"],
      "paths": ["sdk/js/packages/electron"],
      "release_artifact": "javascript-source-archive",
      "state": "active",
      "versioning": "coordinated"
    },
    {
      "id": "tauri",
      "owners": ["desktop"],
      "paths": ["sdk/tauri", "sdk/js/packages/tauri"],
      "release_artifact": "tauri-source-archive",
      "state": "active",
      "versioning": "coordinated"
    }
  ],
  "format": "chill-component-registry-v1"
}
