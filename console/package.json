{
  "name": "@chill/console",
  "version": "0.1.0",
  "description": "The client-only administration and analytics console for Chill",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sites-worker.mjs",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "lint": "eslint .",
    "vendor:sdk": "npm --prefix ../sdk/web run build && npm pack ../sdk/web --pack-destination vendor"
  },
  "dependencies": {
    "@chill-observability/browser": "file:vendor/chill-observability-browser-0.1.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1"
  },
  "type": "module"
}
