  "methods": {
    "apple.app_thinning_size": {
      "platform": "apple",
      "physical_device": false,
      "description": "Diff compressed and installed sizes for every supported variant in paired Xcode app-thinning reports from clean release archives.",
      "source_url": "https://developer.apple.com/documentation/xcode/reducing-your-app-s-size"
    },
    "apple.xctest_launch": {
      "platform": "apple",
      "physical_device": true,
      "description": "Interleave compiled-out and enabled release builds on the floor device; collect 30 cold launches with XCTApplicationLaunchMetric and signposted Chill initialization slices.",
      "source_url": "https://developer.apple.com/documentation/XCTest/XCTMetric"
    },
    "apple.xctest_micro": {
      "platform": "apple",
      "physical_device": true,
      "description": "Run optimized XCTest clock, CPU, memory, allocation, and storage metrics over batched disabled and enabled hot paths on the floor device.",
      "source_url": "https://developer.apple.com/documentation/XCTest/XCTMetric"
    },
    "apple.sustained_ab": {
      "platform": "apple",
      "physical_device": true,
      "description": "Run five interleaved 30-minute representative journeys in compiled-out and enabled release builds; collect XCTest, Instruments, and MetricKit-compatible CPU, memory, disk, hitch, and failure counters.",
      "source_url": "https://developer.apple.com/documentation/metrickit/monitoring-app-performance-with-metrickit"
    },
    "apple.power_profiler_ab": {
      "platform": "apple",
      "physical_device": true,
      "description": "Compare at least five paired Power Profiler traces on the same unpowered, thermally stable device model and fixed display/network conditions.",
      "source_url": "https://developer.apple.com/documentation/xcode/measuring-your-app-s-power-use-with-power-profiler"
    },
    "apple.network_ab": {
      "platform": "apple",
      "physical_device": true,
      "description": "Capture compressed on-wire bytes for ten 100-record batches and a ten-minute idle window with the same endpoint, protocol, and radio conditions.",
      "source_url": "https://developer.apple.com/documentation/xcode/performance-and-metrics"
    },
    "apple.queue_stress": {
      "platform": "apple",
      "physical_device": true,
      "description": "Exercise the release queue at 100 records/second for 30 minutes, 1,000 records/second for ten seconds, then offline fill and recovery while counting writes, drops, crashes, and hangs."
    },
    "apple.privacy_canary": {
      "platform": "apple",
      "physical_device": false,
      "description": "Seed unique canaries in SwiftUI/UIKit text, secure inputs, accessibility labels, clipboard, HTTP headers/body/query, errors, images, and consent transitions; scan memory snapshots, queues, OTLP, replay, and diagnostics."
    },
    "apple.replay_ab": {
      "platform": "apple",
      "physical_device": true,
      "description": "Compare paired scrolling, animation, navigation, form, image, and masking journeys with XCTHitchMetric, signpost timing, memory, CPU, power, network, disk, and replay frame counters.",
      "source_url": "https://developer.apple.com/documentation/XCTest/XCTMetric"
    },
    "android.bundle_size": {
      "platform": "android",
      "physical_device": false,
      "description": "Diff optimized release AAB/APK download and installed-size estimates for every supported ABI/density using the same R8 and resource-shrinker configuration.",
      "source_url": "https://developer.android.com/topic/performance/reduce-apk-size"
    },
    "android.macrobenchmark_startup": {
      "platform": "android",
      "physical_device": true,
      "description": "Interleave compiled-out and enabled release variants for at least 30 cold starts with Macrobenchmark StartupTimingMetric and named initialization trace sections.",
      "source_url": "https://developer.android.com/topic/performance/benchmarking/macrobenchmark-metrics"
    },
    "android.microbenchmark": {
      "platform": "android",
      "physical_device": true,
      "description": "Use Android Microbenchmark on optimized release code for batched disabled/enabled hot paths, allocations, and queue primitives.",
      "source_url": "https://developer.android.com/topic/performance/benchmarking/benchmarking-overview"
    },
    "android.sustained_ab": {
      "platform": "android",
      "physical_device": true,
      "description": "Run five paired 30-minute journeys and collect Macrobenchmark frame/trace metrics, process memory/CPU, disk, drop, crash, and ANR counters on the floor device.",
      "source_url": "https://developer.android.com/topic/performance/benchmarking/macrobenchmark-overview"
    },
    "android.power_metric_ab": {
      "platform": "android",
      "physical_device": true,
      "description": "Compare five paired Macrobenchmark PowerMetric runs on one supported Pixel power-rail device under fixed thermal, display, account, and network state.",
      "source_url": "https://developer.android.com/topic/performance/benchmarking/macrobenchmark-metrics"
    },
    "android.network_ab": {
      "platform": "android",
      "physical_device": true,
      "description": "Capture compressed on-wire bytes for ten 100-record batches and a ten-minute idle window under identical release and radio conditions."
    },
    "android.queue_stress": {
      "platform": "android",
      "physical_device": true,
      "description": "Exercise 100 records/second for 30 minutes, a 1,000 records/second burst, offline fill, process death, and recovery while counting writes, drops, crashes, and ANRs."
    },
    "android.privacy_canary": {
      "platform": "android",
      "physical_device": false,
      "description": "Seed unique canaries in Compose/View text, password inputs, accessibility labels, clipboard, HTTP headers/body/query, errors, bitmaps, and consent transitions; scan all serialized and diagnostic surfaces."
    },
    "android.replay_ab": {
      "platform": "android",
      "physical_device": true,
      "description": "Compare paired replay journeys with Macrobenchmark FrameTimingMetric, trace sections, memory, CPU, PowerMetric, network, disk, and redaction counters.",
      "source_url": "https://developer.android.com/topic/performance/benchmarking/macrobenchmark-metrics"
    },
    "web.brotli_bundle": {
      "platform": "web",
      "physical_device": false,
      "description": "Diff deterministic production ESM bundles after minification, tree shaking, and Brotli compression; exercise both imported and unused entry points."
    },
    "web.lighthouse_ab": {
      "platform": "web",
      "physical_device": false,
      "description": "Run 30 compiled-out/enabled production journeys in a pinned browser under the floor CPU/network profile; use Lighthouse budgets and PerformanceObserver marks for initialization and blocking work.",
      "source_url": "https://web.dev/articles/use-lighthouse-for-performance-budgets"
    },
    "web.microbenchmark": {
      "platform": "web",
      "physical_device": false,
      "description": "Measure large batches of disabled/enabled hot paths in a pinned production browser so timer precision cannot dominate individual calls."
    },
    "web.sustained_ab": {
      "platform": "web",
      "physical_device": false,
      "description": "Run five paired 30-minute journeys under the floor browser profile; collect process/heap, task, event, layout, CPU, storage, error, and dropped PerformanceObserver entry data.",
      "source_url": "https://developer.mozilla.org/en-US/docs/Web/API/PerformanceObserver/observe"
    },
    "web.network_ab": {
      "platform": "web",
      "physical_device": false,
      "description": "Use browser network instrumentation to measure compressed bytes for ten 100-record batches and requests during a ten-minute idle window."
    },
    "web.queue_stress": {
      "platform": "web",
      "physical_device": false,
      "description": "Exercise worker/main-thread queues, IndexedDB offline fill, quota pressure, reload, and recovery at the rated steady and burst loads."
    },
    "web.privacy_canary": {
      "platform": "web",
      "physical_device": false,
      "description": "Seed unique canaries in textContent, inputs, ARIA labels, clipboard, URL/query, fetch headers/body, errors, canvas/media, storage, and consent transitions; scan heap and every output."
    },
    "web.replay_ab": {
      "platform": "web",
      "physical_device": false,
      "description": "Compare paired DOM/replay journeys under the floor browser profile using user timing, PerformanceObserver event/long-task/layout entries, heap, network, storage, and masking counters.",
      "source_url": "https://w3c.github.io/longtasks/"
    },
    "server.image_size": {
      "platform": "server",
      "physical_device": false,
      "description": "Diff reproducible stripped production artifact or compressed container-layer size with and without the Chill server module."
    },
    "server.process_ab": {
      "platform": "server",
      "physical_device": false,
      "description": "Run compiled-out/enabled optimized service builds on an isolated pinned runner; collect at least 30 startup samples and five 30-minute throughput, CPU, RSS, queue, disk, and failure trials."
    },
    "server.network_ab": {
      "platform": "server",
      "physical_device": false,
      "description": "Measure compressed OTLP bytes for ten 100-record batches and a ten-minute idle service window against a local fixed collector."
    },
    "server.queue_stress": {
      "platform": "server",
      "physical_device": false,
      "description": "Exercise rated steady/burst ingestion, collector loss, queue cap, restart, and recovery while counting writes, drops, crashes, and stalls."
    },
    "server.privacy_canary": {
      "platform": "server",
      "physical_device": false,
      "description": "Seed canaries in request headers/body/query, credentials, errors, logs, job payloads, and consent/tenant transitions; scan process output, queues, OTLP, and diagnostics."
    }
  },
